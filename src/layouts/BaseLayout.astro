---
import type { ImageMetadata } from 'astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import type { BlogLanguageLink } from '../utils/blog';

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  ogType?: string;
  articleDate?: string;
  updatedDate?: string;
  heroImage?: ImageMetadata;
  lang?: string;
  languageLinks?: BlogLanguageLink[];
  noindex?: boolean;
}

const {
  title,
  description,
  keywords,
  ogType,
  articleDate,
  updatedDate,
  heroImage,
  lang = 'en',
  languageLinks,
  noindex,
} = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <BaseHead
      title={title}
      description={description}
      keywords={keywords}
      ogType={ogType}
      articleDate={articleDate}
      updatedDate={updatedDate}
      heroImage={heroImage}
      lang={lang}
      languageLinks={languageLinks}
      noindex={noindex}
    />
  </head>
  <body>
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:px-4 focus:py-2 focus:bg-ink focus:text-paper focus:rounded focus:text-sm focus:font-medium"
    >
      Skip to main content
    </a>
    <Header />
    <main id="main-content" class="max-w-container mx-auto px-5 sm:px-6 pt-10 sm:pt-16 w-full">
      <slot />
    </main>
    <Footer />
  </body>
</html>
