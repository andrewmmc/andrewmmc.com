---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import type { BlogLanguageLink } from '../utils/blog';

type Props = CollectionEntry<'blog'>['data'] & {
  lang?: string;
  languageLinks?: BlogLanguageLink[];
};

const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  lang = 'en',
  languageLinks = [],
} = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  lang={lang}
  ogType="article"
  articleDate={pubDate.toISOString()}
  updatedDate={updatedDate?.toISOString()}
  heroImage={heroImage}
  languageLinks={languageLinks}
>
  <article>
    <header class="mb-10 sm:mb-14">
      <h1 class="text-title font-semibold text-ink mb-4 [text-wrap:pretty]">{title}</h1>
      <p class="text-[0.9375rem] text-muted flex flex-wrap items-center gap-x-2 gap-y-1 tabular-nums">
        <FormattedDate date={pubDate} />
        {updatedDate && (
          <>
            <span aria-hidden="true" class="text-subtle">
              &middot;
            </span>
            <span>
              Updated <FormattedDate date={updatedDate} />
            </span>
          </>
        )}
        {languageLinks.map((languageLink) => (
          <>
            <span aria-hidden="true" class="text-subtle">
              &middot;
            </span>
            <span>
              Read in{' '}
              <a
                href={languageLink.url}
                hreflang={languageLink.language}
                class="text-ink underline decoration-rule-strong decoration-1 underline-offset-4 hover:decoration-ink"
              >
                {languageLink.label}
              </a>
            </span>
          </>
        ))}
      </p>
    </header>
    <div class="prose">
      <slot />
    </div>
    <div class="mt-16">
      <a href="/" class="inline-flex py-2 text-[0.9375rem] text-muted hover:text-ink">
        &larr; All writing
      </a>
    </div>
  </article>
</BaseLayout>
