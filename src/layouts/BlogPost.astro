---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import type { BlogLanguageLink } from '../utils/blog';

type Props = CollectionEntry<'blog'>['data'] & {
  lang?: string;
  languageLinks?: BlogLanguageLink[];
};

const { title, description, pubDate, updatedDate, lang = 'en', languageLinks = [] } = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  lang={lang}
  ogType="article"
  articleDate={pubDate.toISOString()}
>
  <article>
    <header class="mb-10 pb-8 border-b border-stone-200">
      <h2 class="font-heading text-4xl text-stone-900 leading-tight mb-3 tracking-tight">
        {title}
      </h2>
      <div class="text-sm text-stone-500 flex items-center gap-2">
        <FormattedDate date={pubDate} />
        {
          updatedDate && (
            <span class="italic">
              &middot; Updated: <FormattedDate date={updatedDate} />
            </span>
          )
        }
      </div>
      {
        languageLinks.length > 0 && (
          <div class="mt-3 text-sm text-stone-600">
            Available in:{' '}
            {languageLinks.map((languageLink, index) => (
              <>
                {index > 0 && <span class="mx-1 text-stone-400">/</span>}
                <a
                  href={languageLink.url}
                  class="text-amber-700 hover:text-amber-800 underline underline-offset-2"
                >
                  {languageLink.label}
                </a>
              </>
            ))}
          </div>
        )
      }
    </header>
    <div class="prose">
      <slot />
    </div>
    <div class="mt-12 pt-8 border-t border-stone-200">
      <a
        href="/"
        class="text-sm text-stone-600 hover:text-stone-800 transition-colors duration-150"
      >
        &larr; Back to writing
      </a>
    </div>
  </article>
</BaseLayout>
