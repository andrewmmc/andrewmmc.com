---
export interface DataTableRow {
  label?: string;
  rowSpan?: number;
  title: string;
  href?: string;
  meta?: string;
  external?: boolean;
}

interface Props {
  heading: string;
  headingId: string;
  rows: DataTableRow[];
  wideLabel?: boolean;
  numericLabels?: boolean;
  class?: string;
}

const {
  heading,
  headingId,
  rows,
  wideLabel = false,
  numericLabels = false,
  class: className,
} = Astro.props;

const showMeta = rows.some((row) => row.meta);
---

<section aria-labelledby={headingId} class={className}>
  <h2 id={headingId} class="section-label mb-4">
    {heading}
  </h2>
  <table aria-labelledby={headingId}>
    <tbody>
      {rows.map((row) => (
        <tr>
          {row.label != null && (
            <th
              scope="row"
              rowspan={row.rowSpan}
              class:list={[wideLabel && 'wide', numericLabels && 'tabular-nums']}
            >
              {row.label}
            </th>
          )}
          <td>
            {row.href ? (
              <a
                href={row.href}
                target={row.external ? '_blank' : undefined}
                rel={row.external ? 'noopener noreferrer' : undefined}
              >
                {row.title}
                {row.external && <span class="sr-only">(opens in a new tab)</span>}
              </a>
            ) : (
              row.title
            )}
          </td>
          {showMeta && <td class="meta">{row.meta}</td>}
        </tr>
      ))}
    </tbody>
  </table>
</section>

<style>
  table {
    width: 100%;
    border-collapse: collapse;
    border-top: 1px solid var(--color-rule);
    font-size: 1rem;
    line-height: 1.4;
  }

  th,
  td {
    border-bottom: 1px solid var(--color-rule);
    padding: 0.875rem 0;
    text-align: left;
    vertical-align: baseline;
  }

  th {
    width: 5.5rem;
    padding-right: 1.5rem;
    color: var(--color-subtle);
    font-size: 0.875rem;
    font-weight: 400;
    letter-spacing: 0;
  }

  th.wide {
    width: 10.5rem;
  }

  td {
    color: var(--color-ink);
    letter-spacing: -0.011em;
  }

  td.meta {
    width: 16rem;
    padding-left: 1.5rem;
    color: var(--color-subtle);
    font-size: 0.875rem;
    letter-spacing: 0;
    text-align: right;
  }

  a {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: var(--color-rule-strong);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  a:hover {
    text-decoration-color: currentColor;
  }

  @media (max-width: 639px) {
    table,
    tbody,
    tr,
    th,
    th.wide,
    td,
    td.meta {
      display: block;
      width: auto;
      text-align: left;
    }

    th {
      border-bottom: 0;
      padding: 1.15rem 0 0.15rem;
    }

    td {
      padding-top: 0.2rem;
      padding-bottom: 0;
    }

    td.meta {
      padding-left: 0;
      text-align: left;
    }

    td:last-child {
      padding-bottom: 0.9rem;
    }

    td:not(:last-child) {
      border-bottom: 0;
    }

    tr:not(:has(th)) td:first-of-type {
      padding-top: 0.9rem;
    }
  }
</style>
