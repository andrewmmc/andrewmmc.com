---
import { SITE_TITLE, SOCIAL_LINKS } from '../consts';

const year = new Date().getFullYear();

const links = [
  { href: `https://github.com/${SOCIAL_LINKS.github}`, label: 'GitHub', external: true },
  { href: `https://linkedin.com/in/${SOCIAL_LINKS.linkedin}`, label: 'LinkedIn', external: true },
  { href: '/rss.xml', label: 'RSS' },
];
---

<footer class="max-w-container mx-auto px-5 sm:px-6 mt-24 sm:mt-32">
  <div class="flex flex-col-reverse gap-3 sm:flex-row sm:items-center sm:justify-between border-t border-rule pt-6 pb-10 sm:pb-14 text-sm text-muted">
    <span>
      &copy; {year} {SITE_TITLE}
    </span>
    <ul class="flex items-center gap-5">
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            target={link.external ? '_blank' : undefined}
            rel={link.external ? 'noopener noreferrer' : undefined}
            class="inline-flex py-1 text-muted hover:text-ink"
          >
            {link.label}
            {link.external && <span class="sr-only">(opens in a new tab)</span>}
          </a>
        </li>
      ))}
    </ul>
  </div>
</footer>
