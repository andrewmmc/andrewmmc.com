---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import type { ImageMetadata } from 'astro';
import '../styles/global.css';
import { SITE_TITLE, SITE_DESCRIPTION, SITE_URL, SOCIAL_LINKS } from '../consts';
import type { BlogLanguageLink } from '../utils/blog';

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  ogType?: string;
  articleDate?: string;
  updatedDate?: string;
  heroImage?: ImageMetadata;
  lang?: string;
  languageLinks?: BlogLanguageLink[];
  noindex?: boolean;
}

const LOCALE_MAP: Record<string, string> = {
  en: 'en_US',
  'zh-hant': 'zh_Hant',
};

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const {
  title,
  description = SITE_DESCRIPTION,
  keywords,
  ogType = 'website',
  articleDate,
  updatedDate,
  heroImage,
  lang = 'en',
  languageLinks = [],
  noindex = false,
} = Astro.props;

const pageTitle = title ? `${title} \u2013 ${SITE_TITLE}` : SITE_TITLE;
const ogLocale = LOCALE_MAP[lang] ?? 'en_US';

// Social share image: use hero image for articles when available, fallback to avatar
const defaultSocialImage = new URL('/avatar.jpg', Astro.site).href;
const socialImage = heroImage ? new URL(heroImage.src, Astro.site).href : defaultSocialImage;
const socialImageWidth = heroImage?.width ?? 460;
const socialImageHeight = heroImage?.height ?? 460;
const socialImageWidthStr = String(socialImageWidth);
const socialImageHeightStr = String(socialImageHeight);
const socialImageAlt = heroImage ? `${title} – article hero image` : `${SITE_TITLE} profile photo`;
const twitterCardType = heroImage ? 'summary_large_image' : 'summary';

// Hreflang alternate links for multi-language content
const allLanguageVariants = [
  { language: lang, url: canonicalURL.href },
  ...languageLinks.map((link) => ({
    language: link.language,
    url: new URL(link.url, Astro.site).href,
  })),
];
const xDefaultUrl = allLanguageVariants.find((v) => v.language === 'en')?.url ?? canonicalURL.href;

// JSON-LD Structured Data
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE_TITLE,
  url: SITE_URL,
  image: defaultSocialImage,
  jobTitle: 'Software Engineer',
  sameAs: [
    `https://github.com/${SOCIAL_LINKS.github}`,
    `https://linkedin.com/in/${SOCIAL_LINKS.linkedin}`,
  ],
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE_TITLE,
  url: SITE_URL,
  description: SITE_DESCRIPTION,
  author: {
    '@type': 'Person',
    name: SITE_TITLE,
  },
};

const articleSchema =
  ogType === 'article'
    ? {
        '@context': 'https://schema.org',
        '@type': 'BlogPosting',
        headline: title,
        description: description,
        datePublished: articleDate,
        dateModified: updatedDate ?? articleDate,
        image: socialImage,
        author: {
          '@type': 'Person',
          name: SITE_TITLE,
          url: SITE_URL,
        },
        publisher: {
          '@type': 'Person',
          name: SITE_TITLE,
          url: SITE_URL,
        },
        mainEntityOfPage: {
          '@type': 'WebPage',
          '@id': canonicalURL.href,
        },
      }
    : null;
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="theme-color" content="#fafaf9" />
<meta name="author" content={SITE_TITLE} />
<meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
<link rel="icon" href="/favicon.png" />
<link rel="icon" href="/favicon.ico" sizes="any" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
  rel="alternate"
  type="application/rss+xml"
  title={SITE_TITLE}
  href={new URL('rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<!-- Google Fonts - Figtree + Instrument Serif (non-render-blocking) -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Figtree:ital,wght@0,300..900;1,300..900&display=swap"
/>

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Hreflang alternate links for multi-language content -->
{
  languageLinks.length > 0 && (
    <>
      {allLanguageVariants.map((variant) => (
        <link rel="alternate" hreflang={variant.language} href={variant.url} />
      ))}
      <link rel="alternate" hreflang="x-default" href={xDefaultUrl} />
    </>
  )
}

<!-- Primary Meta Tags -->
<title>{pageTitle}</title>
<meta name="title" content={pageTitle} />
<meta name="description" content={description} />
{keywords && <meta name="keywords" content={keywords} />}

<!-- Open Graph / Facebook -->
<meta property="og:type" content={ogType} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:locale" content={ogLocale} />
<meta property="og:image" content={socialImage} />
<meta property="og:image:width" content={socialImageWidthStr} />
<meta property="og:image:height" content={socialImageHeightStr} />
<meta property="og:image:alt" content={socialImageAlt} />
{
  ogType === 'article' && articleDate && (
    <meta property="article:published_time" content={articleDate} />
  )
}
{
  ogType === 'article' && updatedDate && (
    <meta property="article:modified_time" content={updatedDate} />
  )
}
{ogType === 'article' && <meta property="article:author" content={SITE_TITLE} />}

<!-- Twitter -->
<meta name="twitter:card" content={twitterCardType} />
<meta name="twitter:url" content={canonicalURL} />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={socialImage} />
<meta name="twitter:image:alt" content={socialImageAlt} />

<!-- JSON-LD Structured Data -->
<script is:inline type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
<script is:inline type="application/ld+json" set:html={JSON.stringify(personSchema)} />
{
  articleSchema && (
    <script is:inline type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  )
}
