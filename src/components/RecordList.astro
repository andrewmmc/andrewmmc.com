---
export interface RecordListItem {
  title: string;
  href?: string;
  meta?: string;
  external?: boolean;
}

interface Props {
  heading: string;
  headingId: string;
  groups: { label: string; items: RecordListItem[] }[];
  labelWidthClass?: string;
  numericLabels?: boolean;
  class?: string;
}

const {
  heading,
  headingId,
  groups,
  labelWidthClass = 'sm:grid-cols-[5.5rem_1fr]',
  numericLabels = false,
  class: className,
} = Astro.props;
---

<section aria-labelledby={headingId} class={className}>
  <h2 id={headingId} class="section-label mb-4">
    {heading}
  </h2>
  <div class="border-t border-rule">
    {groups.map(({ label, items }) => (
      <div class:list={['sm:grid border-b border-rule', labelWidthClass]}>
        <h3
          class:list={[
            'pt-5 pb-1 sm:py-4 pr-4 text-sm font-normal text-subtle tracking-normal',
            numericLabels && 'tabular-nums',
          ]}
        >
          {label}
        </h3>
        <ul>
          {items.map((item) => (
            <li class="border-b border-rule last:border-b-0">
              {item.href ? (
                <a
                  href={item.href}
                  target={item.external ? '_blank' : undefined}
                  rel={item.external ? 'noopener noreferrer' : undefined}
                  class="group flex flex-col gap-1 py-3.5 sm:flex-row sm:items-baseline sm:justify-between sm:gap-x-6 sm:py-4"
                >
                  <span class="min-w-0 text-ink text-base leading-snug tracking-[-0.011em] decoration-1 underline-offset-4 group-hover:underline">
                    {item.title}
                    {item.external && <span class="sr-only">(opens in a new tab)</span>}
                  </span>
                  {item.meta && (
                    <span class="text-sm text-subtle sm:text-right sm:flex-shrink-0 sm:max-w-[16rem]">
                      {item.meta}
                    </span>
                  )}
                </a>
              ) : (
                <div class="flex flex-col gap-1 py-3.5 sm:flex-row sm:items-baseline sm:justify-between sm:gap-x-6 sm:py-4">
                  <span class="min-w-0 text-ink text-base leading-snug tracking-[-0.011em]">
                    {item.title}
                  </span>
                  {item.meta && (
                    <span class="text-sm text-subtle sm:text-right sm:flex-shrink-0 sm:max-w-[16rem]">
                      {item.meta}
                    </span>
                  )}
                </div>
              )}
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</section>
