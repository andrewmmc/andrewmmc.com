---
import NavIcon from './NavIcon.astro';
import { SITE_TITLE } from '../consts';

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';

const navLinks = [
  {
    href: '/',
    label: 'Writing',
    icon: 'writing' as const,
    active: pathname === '/' || pathname.startsWith('/blog'),
  },
  {
    href: '/about',
    label: 'About',
    icon: 'about' as const,
    active: pathname === '/about',
  },
  {
    href: 'https://mmc.dev/',
    label: 'Projects',
    icon: 'projects' as const,
    external: true,
  },
];
---

<header class="max-w-container mx-auto px-5 sm:px-6">
  <div class="flex items-center justify-between gap-4 h-16 sm:h-20">
    <a
      href="/"
      aria-label={SITE_TITLE}
      title={SITE_TITLE}
      class="inline-flex items-center justify-center size-8 rounded-full bg-ink text-paper text-[0.8125rem] font-semibold tracking-[-0.02em] leading-none shrink-0 select-none transition-opacity duration-150 hover:opacity-80 focus-visible:rounded-full"
    >
      A
    </a>
    <nav aria-label="Main navigation">
      <ul class="flex items-center gap-0.5 sm:gap-1">
        {navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              aria-label={link.external ? `${link.label} (opens in a new tab)` : link.label}
              title={link.label}
              aria-current={link.active ? 'page' : undefined}
              target={link.external ? '_blank' : undefined}
              rel={link.external ? 'noopener noreferrer' : undefined}
              class:list={[
                'inline-flex items-center justify-center size-10 rounded-md transition-colors duration-150',
                link.active ? 'text-ink bg-surface' : 'text-muted hover:text-ink hover:bg-surface',
              ]}
            >
              <NavIcon name={link.icon} />
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>
