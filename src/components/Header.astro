---
import { SITE_TITLE } from '../consts';

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';

const navLinks = [
  { href: '/', label: 'Writing', active: pathname === '/' || pathname.startsWith('/blog') },
  { href: '/about', label: 'About', active: pathname === '/about' },
  { href: 'https://mmc.dev/', label: 'Projects', external: true },
];
---

<header class="max-w-container mx-auto px-5 sm:px-6">
  <div class="flex items-center justify-between gap-4 h-16 sm:h-20">
    <a
      href="/"
      class="text-[0.9375rem] max-[359px]:text-sm font-semibold tracking-[-0.015em] text-ink whitespace-nowrap"
    >
      {SITE_TITLE}
    </a>
    <nav aria-label="Main navigation">
      <ul class="flex items-center gap-5 max-[359px]:gap-3.5 sm:gap-7">
        {navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={link.active ? 'page' : undefined}
              target={link.external ? '_blank' : undefined}
              rel={link.external ? 'noopener noreferrer' : undefined}
              class:list={[
                'inline-flex items-center py-2 text-[0.9375rem] max-[359px]:text-sm transition-colors duration-150',
                link.active ? 'text-ink' : 'text-muted hover:text-ink',
              ]}
            >
              {link.label}
              {link.external && <span class="sr-only">(opens in a new tab)</span>}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>
