---
import { getCollection, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import { getBlogStaticPaths, type BlogPageProps } from '../../utils/blog';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return getBlogStaticPaths(posts);
}
type Props = BlogPageProps;

const { post, lang, languageLinks } = Astro.props as Props;
const { Content } = await render(post);
---

<BlogPost {...post.data} lang={lang} languageLinks={languageLinks}>
  <Content />
</BlogPost>
