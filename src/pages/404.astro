---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" noindex>
  <div class="py-4 sm:py-8">
    <h1 class="text-title font-semibold text-ink mb-4">Page not found</h1>
    <p class="text-muted mb-8 max-w-[34ch]">
      The page you requested cannot be found. The URL may be misspelled or the page you&rsquo;re
      looking for is no longer available.
    </p>
    <a
      href="/"
      class="text-ink underline decoration-rule-strong decoration-1 underline-offset-4 hover:decoration-ink"
    >
      Back to writing
    </a>
  </div>
</BaseLayout>
