---
import { Image } from 'astro:assets';
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import aboutImage from '../assets/about.jpg';

const about = await getEntry('pages', 'about');

if (!about) {
  throw new Error('About page not found');
}

const { Content } = await render(about);
---

<BaseLayout title={about.data.title} description={about.data.description}>
  <article>
    <h1 class="text-title font-semibold text-ink mb-8 sm:mb-10">{about.data.title}</h1>
    <Image
      src={aboutImage}
      alt="Profile"
      width={768}
      loading="eager"
      fetchpriority="high"
      class="w-full rounded mb-10"
    />
    <div class="prose">
      <Content />
    </div>
  </article>
</BaseLayout>
